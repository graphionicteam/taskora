// Taskora — Prisma Schema Foundation
// Database: Neon PostgreSQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String                @id @default(cuid())
  email           String                @unique
  name            String?
  passwordHash    String                @map("password_hash")
  avatarUrl       String?               @map("avatar_url")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  invitationsSent WorkspaceInvitation[]
  createdTasks    Task[]                @relation("TaskCreator")
  closedTasks     Task[]                @relation("TaskClosedBy")

  @@map("users")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?
  logoUrl     String?               @map("logo_url")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  designations Designation[]
  tasks        Task[]

  @@map("workspaces")
}

model Designation {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("designations")
}

model WorkspaceMember {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  userId        String         @map("user_id")
  designationId String?        @map("designation_id")
  role          WorkspaceRole  @default(MEMBER)
  status        MemberStatus   @default(ACTIVE)
  joinedAt      DateTime       @default(now()) @map("joined_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  assignedTasks Task[]         @relation("TaskAssignee")

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  invitedById   String            @map("invited_by_id")
  email         String
  role          WorkspaceRole     @default(MEMBER)
  designationId String?           @map("designation_id")
  tokenHash     String            @unique @map("token_hash")
  status        InvitationStatus  @default(PENDING)
  expiresAt     DateTime          @map("expires_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User              @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  designation   Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([tokenHash])
  @@index([email])
  @@map("workspace_invitations")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?     @map("due_date")

  // Primary assignee (must be an active workspace member)
  assigneeId  String?       @map("assignee_id")

  // Creator
  creatorId   String        @map("creator_id")

  // Self-referencing parent-child hierarchy
  parentId    String?       @map("parent_id")

  // Closure audit
  closedAt    DateTime?     @map("closed_at")
  closedById  String?       @map("closed_by_id")

  // Archiving
  isArchived  Boolean       @default(false) @map("is_archived")
  archivedAt  DateTime?     @map("archived_at")

  // Reserved for Phase 05 projects
  projectId   String?       @map("project_id")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    WorkspaceMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  parent      Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]           @relation("TaskHierarchy")
  closedBy    User?            @relation("TaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, isArchived, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, parentId])
  @@index([dueDate])
  @@map("tasks")
}

