// Taskora — Prisma Schema Foundation
// Database: Supabase PostgreSQL (High-Performance Always-On)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String                @id @default(cuid())
  email           String                @unique
  name            String?
  passwordHash    String                @map("password_hash")
  avatarUrl       String?               @map("avatar_url")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  invitationsSent WorkspaceInvitation[]
  createdTasks    Task[]                @relation("TaskCreator")
  closedTasks     Task[]                @relation("TaskClosedBy")
  devicePushTokens DevicePushToken[]

  @@map("users")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?
  logoUrl     String?               @map("logo_url")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  designations   Designation[]
  tasks          Task[]
  attendances    Attendance[]
  officeLocation OfficeLocation?
  projects       Project[]
  conversations  Conversation[]
  notifications  Notification[]

  @@map("workspaces")
}

model Designation {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("designations")
}

model WorkspaceMember {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  userId        String         @map("user_id")
  designationId String?        @map("designation_id")
  role          WorkspaceRole  @default(MEMBER)
  status        MemberStatus   @default(ACTIVE)
  joinedAt      DateTime       @default(now()) @map("joined_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  assignedTasks            Task[]                   @relation("TaskAssignee")
  attendances              Attendance[]
  budgetSplits             ProjectBudgetSplit[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  taskAssignments          TaskAssignment[]
  receivedNotifications    Notification[]           @relation("NotificationRecipient")
  sentNotifications        Notification[]           @relation("NotificationActor")

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  invitedById   String            @map("invited_by_id")
  email         String
  role          WorkspaceRole     @default(MEMBER)
  designationId String?           @map("designation_id")
  tokenHash     String            @unique @map("token_hash")
  status        InvitationStatus  @default(PENDING)
  expiresAt     DateTime          @map("expires_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User              @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  designation   Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([tokenHash])
  @@index([email])
  @@map("workspace_invitations")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?     @map("due_date")

  // Primary assignee (must be an active workspace member)
  assigneeId  String?       @map("assignee_id")

  // Creator
  creatorId   String        @map("creator_id")

  // Self-referencing parent-child hierarchy
  parentId    String?       @map("parent_id")

  // Closure audit
  closedAt    DateTime?     @map("closed_at")
  closedById  String?       @map("closed_by_id")

  // Archiving
  isArchived  Boolean       @default(false) @map("is_archived")
  archivedAt  DateTime?     @map("archived_at")

  // Reserved for Phase 05 projects
  projectId   String?       @map("project_id")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    WorkspaceMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  parent      Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]           @relation("TaskHierarchy")
  closedBy    User?            @relation("TaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  assignments TaskAssignment[]
  chatMessages Message[]

  @@index([workspaceId, isArchived, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, parentId])
  @@index([dueDate])
  @@map("tasks")
}

model Attendance {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  memberId       String          @map("member_id")
  date           String          // "YYYY-MM-DD"
  checkInTime    DateTime        @map("check_in_time")
  checkOutTime   DateTime?       @map("check_out_time")
  checkInLat     Float?          @map("check_in_lat")
  checkInLng     Float?          @map("check_in_lng")
  checkOutLat    Float?          @map("check_out_lat")
  checkOutLng    Float?          @map("check_out_lng")
  distanceMeters Float?          @map("distance_meters")
  status         String          @default("PRESENT") // PRESENT, LATE, COMPLETED
  verified       Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member         WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, memberId, date])
  @@index([workspaceId, date])
  @@index([memberId])
  @@map("attendances")
}

model OfficeLocation {
  id           String    @id @default(cuid())
  workspaceId  String    @unique @map("workspace_id")
  name         String    @default("Head Office")
  latitude     Float     @default(23.0225)
  longitude    Float     @default(72.5714)
  radiusMeters Float     @default(100.0) @map("radius_meters")
  qrSecret     String    @default("TASKORA_OFFICE_SECRET_KEY") @map("qr_secret")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("office_locations")
}

model Project {
  id             String               @id @default(cuid())
  workspaceId    String               @map("workspace_id")
  name           String
  description    String?
  clientName     String?              @map("client_name")
  totalBudget    Float                @default(0.0) @map("total_budget")
  currency       String               @default("USD")
  status         String               @default("ACTIVE") // PLANNING, ACTIVE, IN_REVIEW, COMPLETED, ON_HOLD
  companyPercent Float                @default(40.0) @map("company_percent") // e.g. 40% to Company Account
  taxPercent     Float                @default(10.0) @map("tax_percent")     // e.g. 10% taxes
  expenseAmount  Float                @default(0.0)  @map("expense_amount")  // Direct overhead/tool expenses
  startDate      DateTime?            @map("start_date")
  dueDate        DateTime?            @map("due_date")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  distributions  ProjectBudgetSplit[]

  @@index([workspaceId, status])
  @@map("projects")
}

model ProjectBudgetSplit {
  id              String           @id @default(cuid())
  projectId       String           @map("project_id")
  memberId        String?          @map("member_id")
  recipientName   String           @map("recipient_name")
  role            String?
  percentage      Float            @default(0.0)
  allocatedAmount Float            @default(0.0) @map("allocated_amount")
  status          String           @default("PENDING") // PENDING, APPROVED, DISBURSED
  paidAt          DateTime?        @map("paid_at")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member          WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([memberId])
  @@map("project_budget_splits")
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  title       String?
  isGroup     Boolean  @default(false) @map("is_group")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([workspaceId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  memberId       String   @map("member_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  taskId         String?  @map("task_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         WorkspaceMember @relation(fields: [senderId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  recipientId String   @map("recipient_id")
  actorId     String?  @map("actor_id")
  type        String   // "TASK_ASSIGNED", "TASK_BROADCAST", "CHAT_MESSAGE", "OWNER_ALERT"
  title       String
  content     String
  link        String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient   WorkspaceMember  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       WorkspaceMember? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, recipientId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model TaskAssignment {
  id        String          @id @default(cuid())
  taskId    String          @map("task_id")
  memberId  String          @map("member_id")
  createdAt DateTime        @default(now()) @map("created_at")

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([memberId])
  @@map("task_assignments")
}

model DevicePushToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String   @default("web") // "ios", "android", "web"
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_push_tokens")
}
