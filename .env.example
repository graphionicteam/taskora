# Taskora — Environment Configuration Template
# NOTE: Never commit live credentials or secrets to version control.

# Neon PostgreSQL — Connection Pooling (Runtime queries for Serverless / Next.js)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/taskora?sslmode=require&pgbouncer=true"

# Neon PostgreSQL — Direct Connection (DDL & Schema migrations only)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/taskora?sslmode=require"

# Auth.js Encryption Secret (Generate via `openssl rand -base64 32`)
AUTH_SECRET="your-32-character-secret-key-goes-here"

# Registration Gate: Set to "true" to allow registration (Disabled by default in production)
ALLOW_REGISTRATION="false"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
